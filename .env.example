# Copy to .env.local and fill in your details

# Appointment emails (GoDaddy / secureserver for @aurajewellery.in)
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=info@aurajewellery.in
SMTP_PASS=your-mailbox-password
BUSINESS_EMAIL=info@aurajewellery.in

# Razorpay checkout (required for Pay on cart)
# Dashboard → https://dashboard.razorpay.com/app/keys
# Use Test keys while developing, Live keys in production.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Owner dashboard at /admin (required for product + order management)
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_SECRET=another-long-random-string

# Persistent store (production on Vercel — required for orders/admin data)
# Create Neon Postgres or Vercel Postgres, then paste the connection string.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Product & custom-request image uploads (production on Vercel)
# Vercel project → Storage → Blob → create store → copy token
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx
